# GitHub personal access token with `repo` read scope (PRs, reviews, comments)
GITHUB_TOKEN=

# Jira Cloud REST API access
JIRA_BASE_URL=https://arbisoft.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Required on Vercel. The browser prompts for these credentials before it can
# view the dashboard or use the Jira edit API. They are optional locally.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Required on Vercel for scheduled refreshes and the private snapshot store.
CRON_SECRET=
BLOB_READ_WRITE_TOKEN=
