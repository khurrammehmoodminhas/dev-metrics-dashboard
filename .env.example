# ---------------------------------------------------------------------------
# Dev Metrics Dashboard — configuration template
#
# Copy to .env and fill in your project's values. Every setting is documented
# in docs/CONFIGURATION.md. Never commit .env; only this example is tracked.
# Run `npm run check` to validate everything and verify credentials.
# ---------------------------------------------------------------------------

# --- Project -----------------------------------------------------------------
# Display name shown in the dashboard header and page title.
PROJECT_NAME=My Project

# --- Jira (required) ---------------------------------------------------------
# Your Jira Cloud site.
JIRA_BASE_URL=https://your-org.atlassian.net
# Atlassian account email + API token (id.atlassian.com → Security → API tokens).
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
# The project key — the prefix of your ticket keys (ABC in ABC-123).
JIRA_PROJECT_KEY=ABC

# Custom field ids. Run `npm run jira:fields` to list your site's fields.
JIRA_STORY_POINTS_FIELD=customfield_10016
# Optional. Leave blank if your team doesn't record actual/delivered points.
JIRA_ACTUAL_POINTS_FIELD=
# Optional. Leave blank if your team doesn't record AI contribution on tickets.
JIRA_AI_CONTRIBUTION_FIELD=
# How the AI contribution field stores its value: "fraction" (0–1) or "percent" (0–100).
JIRA_AI_CONTRIBUTION_SCALE=fraction

# Workflow status names used for the In Progress → Code Review cycle-time metric
# (comma-separated, case-insensitive).
JIRA_IN_PROGRESS_STATUSES=In Progress
JIRA_CODE_REVIEW_STATUSES=Code Review

# Which releases (Jira versions / fixVersions) to track.
# Default: every unreleased version plus versions released in the last N months.
JIRA_RELEASE_LOOKBACK_MONTHS=6
# Optional explicit allowlist instead of auto-discovery, e.g. "1.2.0,1.3.0".
JIRA_RELEASES=
# Optional: which of the tracked releases are selected when the page opens.
DEFAULT_RELEASES=
# Optional: restrict to issue types, e.g. "Story,Bug,Task".
JIRA_ISSUE_TYPES=

# --- GitHub (optional — leave GITHUB_REPOS blank to disable PR evidence) ----
# Fine-grained token with read access to Pull requests, Contents and Metadata
# on the repositories below (classic tokens: `repo` scope).
GITHUB_TOKEN=
# Comma-separated owner/name list, e.g. "acme/web,acme/api".
GITHUB_REPOS=
# Optional: only count PRs targeting this branch (e.g. main). Blank = all PRs.
GITHUB_BASE_BRANCH=
# How far back to fetch PRs on first run; bounds ticket → PR evidence.
GITHUB_LOOKBACK_DAYS=90
# Open PRs older than this appear in the team-level stale list.
GITHUB_STALE_PR_AFTER_DAYS=14

# --- AI contribution tracking -----------------------------------------------
# Set to false to hide all AI-contribution metrics and skip PR parsing.
AI_CONTRIBUTION_ENABLED=true
# Heading of the checklist table in PR descriptions (see docs/AI_CONTRIBUTION.md).
AI_CHECKLIST_HEADING=AI Contribution Checklist
# Names that count as AI tools in "Co-Authored-By:" commit trailers.
AI_COAUTHOR_PATTERNS=claude,copilot,cursor,codex,gemini,devin,aider

# --- Assistant (optional) ----------------------------------------------------
# Any OpenAI-compatible chat-completions provider that supports tool calling.
# Leave AI_API_KEY blank to disable the "Ask assistant" panel entirely.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
# Optional extra guidance appended to the assistant's system prompt.
ASSISTANT_EXTRA_INSTRUCTIONS=

# --- Write features ----------------------------------------------------------
# Inline Jira editing from the dashboard (SP, AP, AI %, status, assignee...).
JIRA_EDITING_ENABLED=true
# "Log code review time" → posts a comment on the Jira ticket.
REVIEW_LOGGING_ENABLED=true
REVIEW_COMMENT_TEMPLATE={reviewer} spent {time} on code review

# --- Server / deployment -----------------------------------------------------
PORT=3000
# Interface the local server listens on. Loopback by default; set 0.0.0.0
# only behind authentication (the server can write to Jira).
HOST=127.0.0.1
# Where cache/output files live locally (default: ./data).
DATA_DIR=

# Required on Vercel; optional locally (enforced by the local server when set):
# HTTP Basic Auth for the whole site.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
# Required on Vercel: secret for the scheduled refresh (Vercel Cron).
CRON_SECRET=
# Required on Vercel: token of a *private* Vercel Blob store (snapshot + review logs).
BLOB_READ_WRITE_TOKEN=
